{
  "name": "@politeshop/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@openrouter/sdk": "^0.8.0",
    "@politeshop/ai": "workspace:*",
    "@politeshop/lib": "workspace:*",
    "@politeshop/shared": "workspace:*",
    "bits-ui": "^2.9.3",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^1.17.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-vercel": "^7.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "drizzle-kit": "^0.31.9",
    "mockwright": "^0.0.1",
    "pino-pretty": "^13.0.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "26.x"
  }
}
